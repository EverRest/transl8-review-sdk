{
  "name": "@transl8.ai/review-sdk",
  "version": "0.9.3",
  "description": "Browser SDK for in-context translation review: hover keyed text, propose translations, ask AI for an analysis and report issues.",
  "keywords": [
    "translation",
    "localization",
    "i18n",
    "review",
    "sdk",
    "browser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EverRest/transl8-review-sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/verify-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  }
}
